{
  "name": "@sorarisu/dsh-drawio",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "draw.io diagrams for DeepSeek Harness: an agent tool that writes .drawio files, plus a sidebar panel with an embedded draw.io editor and an offline SVG preview.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "drawio",
    "diagrams.net",
    "diagram",
    "flowchart",
    "mxgraph",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nvoyo/dsh-drawio.git"
  },
  "homepage": "https://github.com/Nvoyo/dsh-drawio#readme",
  "bugs": {
    "url": "https://github.com/Nvoyo/dsh-drawio/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "author": "Nvoyo"
}
